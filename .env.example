# Supabase — crear un proyecto en https://supabase.com y copiar desde
# Project Settings > API Keys. Usá la PUBLISHABLE KEY (sb_publishable_…), que es la
# nueva clave pública de cliente (reemplaza a la vieja "anon"). Es pública (protegida
# por RLS), pero igual el archivo .env real NO se commitea (está en .gitignore).
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu-clave
